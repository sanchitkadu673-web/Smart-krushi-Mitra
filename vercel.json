{
  "experimentalServices": {
    "frontend": {
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist",
      "rootDirectory": "frontend",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "buildCommand": "npm install && npm run build",
      "startCommand": "node dist/index.js",
      "rootDirectory": "backend"
    }
  }
}
